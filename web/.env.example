# Postgres connection string (Neon on Vercel, or a local database for development)
DATABASE_URL=postgres://localhost/pmcopy_dev
# 32+ random characters; signs login sessions.            openssl rand -hex 32
SESSION_SECRET=
# 32 random bytes, base64; encrypts stored wallet keys.    openssl rand -base64 32
# Losing or changing this makes every stored wallet key unreadable.
ENCRYPTION_KEY=
# Bearer token the schedulers send to /api/cron/*.         openssl rand -hex 24
CRON_SECRET=
# Must be exactly "true" before anyone can connect a wallet or place real orders.
LIVE_TRADING_ENABLED=false
# Comma-separated country codes whose visitors may not switch on live trading.
RESTRICTED_COUNTRIES=US
